# Движок: claude или codex
AGENT_ENGINE=claude
# Codex: один раз выполните codex login --device-auth под пользователем бота.
# Используется подписка ChatGPT, OPENAI_API_KEY не нужен.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому разрешено писать боту (через запятую). Первый id получает напоминания.
# Свой id: напишите @userinfobot (или любой id, запустите бота и напишите ему — он ответит вашим id).
TELEGRAM_ALLOWED_USERS=

# --- Claude: раскомментируйте один из двух ---
# API-ключ с console.anthropic.com (оплата за токены)
#ANTHROPIC_API_KEY=sk-ant-...
# Или токен подписки Pro/Max: выполнить `claude setup-token` на любой машине
#CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Модель (пусто — по умолчанию Claude Code), например claude-sonnet-5-5 или claude-opus-5-5
CLAUDE_MODEL=
# Лимит стоимости одного хода в USD (пусто — без лимита)
CLAUDE_MAX_BUDGET_USD=
# Разрешить Claude выполнять shell-команды в рабочей папке
CLAUDE_ALLOW_BASH=true

# --- Тренер ---
TRAINER_WORKSPACE=~/trainer
TRAINER_TIMEZONE=Europe/Moscow
# Время напоминаний HH:MM, пусто — выключить
MORNING_REMINDER=08:00
EVENING_CHECKIN=21:00
# Ширина рендера артефактов, px
RENDER_WIDTH=800
